# Environment variables for Secure File Transfer
SECRET_KEY=your-very-secure-secret-key-change-this-in-production
FLASK_ENV=development
FLASK_DEBUG=True

# Database settings (for future expansion)
# DATABASE_URL=sqlite:///secure_transfer.db

# SFTP settings (optional)
# SFTP_HOST=your-sftp-server.com
# SFTP_PORT=22
# SFTP_USERNAME=your-username
# SFTP_PRIVATE_KEY_PATH=/path/to/private/key

# Security settings
MAX_FILE_SIZE=104857600  # 100MB in bytes
ALLOWED_EXTENSIONS=*

# Face recognition settings
FACE_RECOGNITION_TOLERANCE=0.6
FACE_DETECTION_MODEL=hog  # hog or cnn

# 2FA settings
TOTP_ISSUER_NAME=Secure File Transfer
TOTP_DIGITS=6
TOTP_INTERVAL=30
